{
  "name": "fangfuzha-vscode-extension",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.2",
  "publisher": "fangfuzha",
  "packageManager": "pnpm@12.15.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fangfuzha/my-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/fangfuzha/my-vscode-extension/issues"
  },
  "homepage": "https://github.com/fangfuzha/my-vscode-extension",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "keywords": [
    "vscode",
    "extension",
    "license",
    "mcp",
    "context7",
    "documentation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "files": [
    "dist/**",
    "media/**",
    "l10n/bundle.l10n*.json",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "media/icon.png"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "fangfuzha/context7",
        "label": "Context7"
      }
    ],
    "commands": [
      {
        "command": "my-vscode-extension.openManager",
        "title": "%command.openManager.title%",
        "category": "%command.category%"
      },
      {
        "command": "my-vscode-extension.license.add",
        "title": "%command.add.title%",
        "category": "%command.licenseCategory%"
      },
      {
        "command": "my-vscode-extension.license.addMultiple",
        "title": "%command.addMultiple.title%",
        "category": "%command.licenseCategory%"
      },
      {
        "command": "my-vscode-extension.license.addDefault",
        "title": "%command.addDefault.title%",
        "category": "%command.licenseCategory%"
      },
      {
        "command": "my-vscode-extension.context7.useTokenMode",
        "title": "%command.context7.useTokenMode.title%",
        "category": "%command.context7.category%"
      },
      {
        "command": "my-vscode-extension.context7.useOAuthMode",
        "title": "%command.context7.useOAuthMode.title%",
        "category": "%command.context7.category%"
      },
      {
        "command": "my-vscode-extension.context7.checkApiKey",
        "title": "%command.context7.checkApiKey.title%",
        "category": "%command.context7.category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "my-vscode-extension.context7.useTokenMode",
          "when": "myVscodeExtension.context7AuthMode == oauth"
        },
        {
          "command": "my-vscode-extension.context7.useOAuthMode",
          "when": "myVscodeExtension.context7AuthMode != oauth"
        },
        {
          "command": "my-vscode-extension.context7.checkApiKey",
          "when": "myVscodeExtension.context7AuthMode != oauth"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node esbuild.js --production",
    "package:dev": "node esbuild.js",
    "watch:bundle": "node esbuild.js --watch",
    "vsix": "vsce package --no-dependencies",
    "typecheck": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.144.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}